# Auto-detect text files and normalize line endings
* text=auto

# Source code
*.h text eol=lf
*.cpp text eol=lf
*.cmake text eol=lf
*.py text eol=lf
CMakeLists.txt text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Config
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.pptx binary
